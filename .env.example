# SafeGuard 环境变量配置
# 复制此文件为 .env 并填入真实的 API Key
# cp .env.example .env
#
# 注意：未配置 API Key 时，对应功能将使用降级/模拟模式，
# 不影响核心系统运行。

# ============================================
# 数据库密码（默认 root123）
# 本地 MySQL 可设空密码: DB_PASSWORD=
# ============================================
DB_PASSWORD=root123

# ============================================
# DeepSeek API Key（AI 对话/检测功能）
# 如不配置，LLM 检测将返回预设分析结果
# 获取地址：https://platform.deepseek.com/
# ============================================
DEEPSEEK_API_KEY=

# ============================================
# SiliconFlow API Key（RAG 向量嵌入/重排）
# 如不配置，嵌入使用哈希降级，仍可工作
# 获取地址：https://cloud.siliconflow.cn/
# ============================================
SILICONFLOW_API_KEY=

# ============================================
# 微信小程序配置（小程序登录功能）
# 如不配置，登录接口返回测试模式 token
# 获取地址：微信公众平台 https://mp.weixin.qq.com/
# ============================================
WECHAT_APPID=
WECHAT_SECRET=
