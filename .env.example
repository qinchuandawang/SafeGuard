# SafeGuard 环境变量配置
# 复制此文件为 .env 并填入真实的 API Key
# cp .env.example .env
#
# 注意：未配置 API Key 时，对应功能将使用降级/模拟模式，
# 不影响核心系统运行。

# ============================================
# 数据库密码（默认 root123）
# 本地 MySQL 可设空密码: DB_PASSWORD=
# ============================================
DB_PASSWORD=root123

# ============================================
# 后端安全/初始化
# ============================================
# 生产环境请设置为足够长的随机字符串（至少 32 字节）
JWT_SECRET=

# 仅在首次初始化管理员时临时设为 true；已有管理员后应保持 false
ADMIN_BOOTSTRAP_REGISTER=false

# Docker 生产环境默认不自动执行 schema/init SQL。
# 首次演示部署如需自动建表可临时设置 SQL_INIT_MODE=always
SQL_INIT_MODE=never

# Docker 默认核心服务不启动 AI profile，因此关闭 Java 端视频预处理。
# 启动 --profile ai 且视频服务可用时可设为 true
VIDEO_PREPROCESS_ENABLED=false

# ============================================
# LLM API Key（SophNet deepseek-v4-pro AI 对话/检测功能）
# 如不配置，application.yml 中已内置默认 Key 用于开发
# ============================================
LLM_API_KEY=
DEEPSEEK_API_KEY=
LLM_MODEL=DeepSeek-V4-Pro

# ============================================
# SiliconFlow API Key（RAG 向量嵌入/重排）
# 如不配置，嵌入使用哈希降级，仍可工作
# 获取地址：https://cloud.siliconflow.cn/
# ============================================
SILICONFLOW_API_KEY=

# ============================================
# 微信小程序配置（小程序登录功能）
# 如不配置，登录接口返回测试模式 token
# 获取地址：微信公众平台 https://mp.weixin.qq.com/
# ============================================
WECHAT_APPID=
WECHAT_SECRET=
# LangGraph 内部服务令牌，生产环境必须使用随机高强度值
ORCHESTRATOR_INTERNAL_TOKEN=
ORCHESTRATOR_MAX_CONCURRENT=4
MULTIMODAL_STAGE_TTL_SECONDS=600
# 备用模型权重和适配器就绪后再填写，禁止用未实现模型冒充回退
AUDIO_FALLBACK_MODEL=
VIDEO_FALLBACK_MODEL=
TEXT_FUSION_WEIGHT=0.25
AUDIO_FUSION_WEIGHT=0.35
VIDEO_FUSION_WEIGHT=0.40
MEMORY_SHORT_TERM_CONTEXT_SIZE=20
MEMORY_SHORT_TERM_TTL_HOURS=24
