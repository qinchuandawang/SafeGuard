/* app.wxss - 诈骗克星 全局样式 - 浅青色主题 */

/* ==================== CSS变量定义 ==================== */
page {
  /* 主色调 - 青色 */
  --primary-color: #00b4d8;
  --primary-color-light: #48cae4;
  --primary-color-dark: #0096c7;

  /* 辅助色 */
  --secondary-color: #0077b6;
  --accent-color: #f59e0b;

  /* 风险等级色 */
  --danger-color: #ef4444;
  --warning-color: #f59e0b;
  --success-color: #10b981;
  --info-color: #3b82f6;

  /* 背景色 - 浅青色主题 */
  --bg-color-primary: #e6f7ff;
  --bg-color-secondary: #b3e5fc;
  --bg-color-card: #ffffff;
  --bg-color-elevated: #ffffff;

  /* 文字颜色 */
  --text-color-primary: #1a1a2e;
  --text-color-secondary: #4a5568;
  --text-color-tertiary: #718096;
  --text-color-disabled: #a0aec0;

  /* 边框颜色 */
  --border-color: #b3e5fc;
  --border-color-light: #e0f2fe;

  /* 渐变色 */
  --gradient-primary: linear-gradient(135deg, #00b4d8 0%, #0096c7 100%);
  --gradient-danger: linear-gradient(135deg, #ef4444 0%, #f59e0b 100%);
  --gradient-success: linear-gradient(135deg, #10b981 0%, #00b4d8 100%);

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  --shadow-glow: 0 0 20rpx rgba(0, 180, 216, 0.2);

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 字体大小 */
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 40rpx;
  --font-size-xxl: 48rpx;

  /* 行高 */
  --line-height-tight: 1.25;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.75;
}

/* ==================== 全局重置样式 ==================== */
page {
  background-color: var(--bg-color-primary);
  color: var(--text-color-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: var(--font-size-md);
  line-height: var(--line-height-normal);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

view, scroll-view, swiper, button, input, textarea, label, navigator, image {
  box-sizing: border-box;
}

/* ==================== 通用导航栏 ==================== */
.page-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-top: calc(constant(safe-area-inset-top) + 40rpx);
  padding-top: calc(env(safe-area-inset-top) + 40rpx);
  background-color: var(--bg-color-primary);
}

.page-nav-left {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-color-primary);
}

.page-nav-right {
  width: 100rpx;
  height: 100rpx;
}

/* ==================== 通用类 ==================== */

/* 容器 */
.container {
  min-height: 100vh;
  padding: var(--spacing-md);
  background-color: var(--bg-color-primary);
}

/* 安全区域 */
.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* Flex布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-around { display: flex; align-items: center; justify-content: space-around; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* 文本对齐 */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

/* 文字颜色 */
.text-primary { color: var(--primary-color); }
.text-secondary { color: var(--text-color-secondary); }
.text-tertiary { color: var(--text-color-tertiary); }
.text-danger { color: var(--danger-color); }
.text-warning { color: var(--warning-color); }
.text-success { color: var(--success-color); }

/* 文字大小 */
.text-xs { font-size: var(--font-size-xs); }
.text-sm { font-size: var(--font-size-sm); }
.text-md { font-size: var(--font-size-md); }
.text-lg { font-size: var(--font-size-lg); }
.text-xl { font-size: var(--font-size-xl); }
.text-xxl { font-size: var(--font-size-xxl); font-weight: bold; }

/* 文字加粗 */
.font-bold { font-weight: bold; }

/* 文字截断 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 间距 */
.mt-xs { margin-top: var(--spacing-xs); } .mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); } .mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }
.mb-xs { margin-bottom: var(--spacing-xs); } .mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); } .mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }
.ml-xs { margin-left: var(--spacing-xs); } .ml-sm { margin-left: var(--spacing-sm); }
.ml-md { margin-left: var(--spacing-md); }
.mr-xs { margin-right: var(--spacing-xs); } .mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }
.pt-xs { padding-top: var(--spacing-xs); } .pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); } .pt-lg { padding-top: var(--spacing-lg); }
.pb-xs { padding-bottom: var(--spacing-xs); } .pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); } .pb-lg { padding-bottom: var(--spacing-lg); }
.px-sm { padding-left: var(--spacing-sm); padding-right: var(--spacing-sm); }
.px-md { padding-left: var(--spacing-md); padding-right: var(--spacing-md); }
.px-lg { padding-left: var(--spacing-lg); padding-right: var(--spacing-lg); }
.py-sm { padding-top: var(--spacing-sm); padding-bottom: var(--spacing-sm); }
.py-md { padding-top: var(--spacing-md); padding-bottom: var(--spacing-md); }
.py-lg { padding-top: var(--spacing-lg); padding-bottom: var(--spacing-lg); }

/* ==================== 卡片样式 ==================== */
.card {
  background-color: var(--bg-color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-md);
}

.card-elevated {
  background-color: var(--bg-color-elevated);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-lg);
}

.card-bordered {
  background-color: var(--bg-color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  border: 1px solid var(--border-color);
}

.card-glow {
  background-color: var(--bg-color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-glow);
  border: 1px solid var(--primary-color);
}

/* 玻璃态卡片（毛玻璃效果） */
.card-glass {
  background-color: rgba(255, 255, 255, 0.68);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.8);
}

/* 特色卡片（左上角彩色条） */
.card-featured {
  background-color: var(--bg-color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}
.card-featured::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: var(--gradient-primary);
  border-radius: 3rpx;
}

/* ==================== 标签样式 ==================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 400;
}
.tag-primary { background-color: rgba(0, 180, 216, 0.10); color: var(--primary-color-dark); }
.tag-danger { background-color: rgba(239, 68, 68, 0.10); color: var(--danger-color); }
.tag-warning { background-color: rgba(245, 158, 11, 0.10); color: var(--warning-color); }
.tag-success { background-color: rgba(16, 185, 129, 0.10); color: var(--success-color); }
.tag-info { background-color: rgba(59, 130, 246, 0.10); color: var(--info-color); }

/* 语义背景 */
.bg-danger-light { background-color: rgba(239, 68, 68, 0.08); }
.bg-warning-light { background-color: rgba(245, 158, 11, 0.08); }
.bg-success-light { background-color: rgba(16, 185, 129, 0.08); }
.bg-info-light { background-color: rgba(59, 130, 246, 0.08); }
.bg-primary-light { background-color: rgba(0, 180, 216, 0.08); }

/* ==================== 按钮样式 ==================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 var(--spacing-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn-primary {
  background: var(--gradient-primary);
  color: #ffffff;
  box-shadow: var(--shadow-glow);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background-color: var(--bg-color-elevated);
  color: var(--primary-color);
  border: 1px solid var(--primary-color);
}

.btn-secondary:active {
  background-color: var(--bg-color-secondary);
}

.btn-danger {
  background: var(--gradient-danger);
  color: #ffffff;
}

.btn-text {
  background-color: transparent;
  color: var(--primary-color);
  height: auto;
  padding: 0;
}

.btn-block {
  width: 100%;
}

/* ==================== 风险等级徽章 ==================== */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  font-weight: 500;
}

.badge-danger {
  background-color: rgba(239, 68, 68, 0.15);
  color: var(--danger-color);
  border: 1px solid var(--danger-color);
}

.badge-warning {
  background-color: rgba(245, 158, 11, 0.15);
  color: var(--warning-color);
  border: 1px solid var(--warning-color);
}

.badge-success {
  background-color: rgba(16, 185, 129, 0.15);
  color: var(--success-color);
  border: 1px solid var(--success-color);
}

.badge-info {
  background-color: rgba(59, 130, 246, 0.15);
  color: var(--info-color);
  border: 1px solid var(--info-color);
}

/* ==================== 分割线 ==================== */
.divider {
  height: 1px;
  background-color: var(--border-color);
  margin: var(--spacing-md) 0;
}

.divider-vertical {
  width: 1px;
  height: 100%;
  background-color: var(--border-color);
  margin: 0 var(--spacing-md);
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
  text-align: center;
}

.empty-state-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-state-title {
  font-size: var(--font-size-lg);
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-sm);
}

.empty-state-description {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
}

/* ==================== 加载动画 ==================== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 3px solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ==================== 进度条 ==================== */
.progress-bar {
  width: 100%;
  height: 8rpx;
  background-color: var(--bg-color-secondary);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

.progress-bar-fill.primary {
  background: var(--gradient-primary);
}

.progress-bar-fill.danger {
  background: var(--gradient-danger);
}

.progress-bar-fill.success {
  background: var(--gradient-success);
}

/* ==================== 动画效果 ==================== */
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUpFadeIn { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
@keyframes breathe { 0%, 100% { box-shadow: 0 0 20rpx rgba(0, 180, 216, 0.2); } 50% { box-shadow: 0 0 40rpx rgba(0, 180, 216, 0.4); } }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
@keyframes slideDownFadeIn { from { opacity: 0; transform: translateY(-20rpx); } to { opacity: 1; transform: translateY(0); } }

.animate-fadeIn { animation: fadeIn 0.3s ease-out; }
.animate-slideUp { animation: slideUpFadeIn 0.5s ease-out; }
.animate-scaleIn { animation: scaleIn 0.3s ease-out; }
.animate-slideDown { animation: slideDownFadeIn 0.3s ease-out; }
.animate-pulse { animation: pulse 2s ease-in-out infinite; }
.animate-breathe { animation: breathe 2s ease-in-out infinite; }

/* 错开动画（列表入场） */
.stagger-1 { animation: slideUpFadeIn 0.5s ease-out both; animation-delay: 0ms; }
.stagger-2 { animation: slideUpFadeIn 0.5s ease-out both; animation-delay: 100ms; }
.stagger-3 { animation: slideUpFadeIn 0.5s ease-out both; animation-delay: 200ms; }
.stagger-4 { animation: slideUpFadeIn 0.5s ease-out both; animation-delay: 300ms; }

/* ==================== 滚动条样式 ==================== */
::-webkit-scrollbar { display: none; width: 0; height: 0; color: transparent; }

/* ==================== 图片样式 ==================== */
image { width: 100%; height: 100%; }

/* ==================== TDesign 组件样式覆盖 ==================== */
t-button { --button-primary-color: var(--primary-color); --button-primary-color-active: var(--primary-color-dark); }
t-input { --input-color: var(--text-color-primary); --input-border-color: var(--border-color); --input-background-color: var(--bg-color-card); }
t-cell { --cell-color: var(--text-color-primary); --cell-background-color: var(--bg-color-card); --cell-border-color: var(--border-color); }
t-navbar { --navbar-color: var(--text-color-primary); --navbar-background-color: var(--bg-color-primary); }

/* ==================== AI问答浮动按钮 ==================== */
.qa-float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #7c3aed, #00b4d8);
  border-radius: 50%;
  box-shadow: var(--shadow-glow);
  z-index: 100;
}
.qa-float-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}

/* ==================== 全局暗色模式 ==================== */
@media (prefers-color-scheme: dark) {
  page {
    --bg-color-primary: #0f172a;
    --bg-color-card: #1e293b;
    --bg-color-elevated: #1e293b;
    --text-color-primary: #f1f5f9;
    --text-color-secondary: #94a3b8;
    --text-color-tertiary: #64748b;
    --border-color: #334155;
    --border-color-light: #1e293b;
    --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.3);
    --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.4);
  }
  .card, .card-bordered, .card-featured, .card-glow { background-color: #1e293b; }
  .card-glass { background-color: rgba(30,41,59,0.7); backdrop-filter: blur(20px); border-color: rgba(51,65,85,0.6); }
  .badge { border-color: transparent; }
  .btn-secondary { border-color: var(--primary-color); }
  t-navbar { --navbar-background-color: #0f172a; --navbar-color: #f1f5f9; }
  .page-navbar { background-color: #0f172a; }
  .page-nav-title { color: #f1f5f9; }
}
