/* pages/detection/detection.wxss - 检测页面样式 */

/* ==================== 页面容器 ==================== */
.detection-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 16% 0%, rgba(0,180,216,0.14), transparent 30%),
    linear-gradient(180deg, #f8fcff 0%, var(--bg-color-primary) 48%, #f8fafc 100%);
  padding-bottom: 120rpx;
}

.page-content { padding-top: var(--spacing-sm);
  padding: 0 0 120rpx;
}

/* ==================== Agent 流程概览 ==================== */
.agent-flow-card {
  position: relative;
  margin: 16rpx 32rpx 22rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 88% 0%, rgba(16,185,129,0.13), transparent 36%),
    radial-gradient(circle at 0% 0%, rgba(0,180,216,0.16), transparent 42%),
    linear-gradient(135deg, rgba(255,255,255,0.98), rgba(232,248,255,0.92));
  color: var(--text-color-primary, #1e293b);
  box-shadow: 0 18rpx 44rpx rgba(14,116,144,0.10);
  overflow: hidden;
  border: 1rpx solid rgba(255,255,255,0.92);
}
.agent-card-glow {
  position: absolute;
  right: -76rpx;
  top: -78rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,180,216,0.12), rgba(0,180,216,0));
}
.agent-card-grid {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  background:
    linear-gradient(180deg, transparent, rgba(0,180,216,0.04)),
    linear-gradient(rgba(0,180,216,0.045) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0,180,216,0.045) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
  opacity: 0.26;
  pointer-events: none;
}
.agent-flow-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.agent-flow-icon-wrap {
  position: relative;
  flex-shrink: 0;
}
.agent-flow-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.98), rgba(224,242,254,0.82));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    inset 0 0 0 1rpx rgba(0,180,216,0.14),
    0 12rpx 28rpx rgba(0,180,216,0.14);
  animation: floatSoft 3.6s ease-in-out infinite;
}
.agent-online-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #22c55e;
  border: 4rpx solid #ffffff;
  animation: dotPulse 1.8s ease-in-out infinite;
}
.agent-flow-text {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.agent-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.agent-flow-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.agent-status-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(34,197,94,0.16);
  color: #059669;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.agent-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #22c55e;
}
.agent-flow-desc {
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-color-secondary, #64748b);
}
.agent-meta-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.72);
  border: 1rpx solid rgba(0,180,216,0.10);
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.56);
}
.agent-meta-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.agent-meta-value {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f766e;
  line-height: 1;
}
.agent-meta-label {
  font-size: 20rpx;
  color: var(--text-color-tertiary, #94a3b8);
  white-space: nowrap;
}
.agent-meta-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(0,180,216,0.12);
}
.agent-flow-steps {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}
.agent-step-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.74);
  color: var(--text-color-secondary, #64748b);
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.agent-step-chip.active {
  background: linear-gradient(135deg, #e0f7ff, #ecfdf5);
  color: #0f766e;
  box-shadow: 0 8rpx 20rpx rgba(0,180,216,0.10);
}
.agent-step-index {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,180,216,0.08);
  color: currentColor;
  font-size: 18rpx;
}
.agent-step-chip.active .agent-step-index {
  background: rgba(15,118,110,0.12);
}
.agent-step-line {
  flex: 1;
  height: 2rpx;
  min-width: 24rpx;
  margin: 0 8rpx;
  background: linear-gradient(90deg, rgba(0,180,216,0.28), rgba(0,180,216,0.07));
}

/* ==================== Tab内容 ==================== */
.tab-content {
  padding: var(--spacing-md) var(--spacing-lg);
}

/* ==================== 上传区域 ==================== */
.upload-section {
  margin-bottom: var(--spacing-md);
}

.upload-area {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 0%, rgba(0,180,216,0.08), transparent 42%),
    rgba(255,255,255,0.92);
  border: 2rpx dashed rgba(0,180,216,0.28);
  border-radius: 30rpx;
  padding: var(--spacing-xl) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all 0.3s ease;
  box-shadow: var(--shadow-sm);
}
.upload-area::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.78);
  pointer-events: none;
}

.upload-area:active {
  border-color: var(--primary-color);
  background-color: #ffffff;
  transform: scale(0.99);
}
.upload-scan {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: -74rpx;
  height: 74rpx;
  background: linear-gradient(180deg, transparent, rgba(0,180,216,0.13), transparent);
  animation: scanLine 5.4s ease-in-out infinite;
  pointer-events: none;
}

.upload-area.has-file {
  border-style: solid;
  border-color: var(--primary-color);
  background: linear-gradient(135deg, rgba(0,180,216,0.08), rgba(16,185,129,0.08));
}
.upload-area.has-file::before {
  content: '';
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #10b981;
  animation: dotPulse 1.6s ease-in-out infinite;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(0,180,216,0.10);
  border-radius: 50%;
  margin-bottom: var(--spacing-md);
  box-shadow: inset 0 0 0 1rpx rgba(0,180,216,0.14);
  animation: floatSoft 3.2s ease-in-out infinite;
}

.upload-text {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-xs);
  font-weight: 700;
}

.upload-hint {
  color: var(--text-color-tertiary);
}

.upload-mini-text {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  margin-top: var(--spacing-xs);
}

.video-upload {
  min-height: 300rpx;
}

/* 文件预览 */
.file-preview {
  width: 100%;
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  background: rgba(255,255,255,0.84);
  border-radius: 22rpx;
  border: 1rpx solid rgba(0,180,216,0.10);
}

.file-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg-color-card);
  border-radius: var(--radius-md);
  margin-right: var(--spacing-sm);
}

.file-info {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.file-size {
  color: var(--text-color-tertiary);
}

.file-remove {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(15,23,42,0.04);
  flex-shrink: 0;
}

.file-remove:active {
  transform: scale(0.94);
  background: rgba(15,23,42,0.08);
}

/* 视频预览 */
.video-preview {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-md);
}

.video-overlay {
  position: absolute;
  top: var(--spacing-sm);
  right: var(--spacing-sm);
  width: 76rpx;
  height: 76rpx;
  background: rgba(15, 23, 42, 0.58);
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.20);
}

.video-overlay:active {
  transform: scale(0.94);
}

/* ==================== 信息卡片 ==================== */
.info-header {
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.info-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
  margin-left: var(--spacing-xs);
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  line-height: 2;
}

/* ==================== 文本输入 ==================== */
.text-input-section {
  margin-bottom: var(--spacing-sm);
}

.text-stats {
  display: flex;
  justify-content: flex-end;
}

.text-count {
  color: var(--text-color-tertiary);
}

/* 示例卡片 */
.examples-card {
  margin-bottom: var(--spacing-md);
}

.examples-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.examples-list {
  display: flex;
  flex-direction: column;
}

.example-item {
  padding: var(--spacing-sm) var(--spacing-sm);
  background: rgba(255,255,255,0.74);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-xs);
  border: 1rpx solid rgba(0,180,216,0.08);
}

.example-item:last-child {
  margin-bottom: 0;
}

.example-item:active {
  opacity: 0.9;
  transform: translateX(8rpx);
}

.example-text {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  line-height: var(--line-height-normal);
}

/* 综合提示 */
.multi-tip {
  background:
    linear-gradient(135deg, rgba(245,158,11,0.13), rgba(255,255,255,0.82));
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.multi-tip-text {
  font-size: var(--font-size-md);
  color: var(--warning-color);
  margin-left: var(--spacing-sm);
  flex: 1;
}

/* ==================== 检测按钮 ==================== */
.action-section {
  position: sticky;
  bottom: 0;
  z-index: 20;
  padding: var(--spacing-md) var(--spacing-lg) calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(238,248,255,0), rgba(238,248,255,0.96) 28%);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

.action-section t-button {
  box-shadow: 0 12rpx 32rpx rgba(0,180,216,0.24);
}

/* ==================== 结果弹窗 ==================== */
.result-popup {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  border-radius: 34rpx 34rpx 0 0;
  overflow: hidden;
}

.result-header {
  padding: var(--spacing-lg);
  border-bottom: 1px solid var(--border-color);
}

.result-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color-primary);
}

.result-close {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(15,23,42,0.04);
  border: 1rpx solid rgba(0,180,216,0.10);
}

.result-close:active {
  transform: scale(0.94);
  background: rgba(224,242,254,0.92);
}

.result-content {
  flex: 1;
  padding: var(--spacing-lg);
  max-height: 60vh;
}

/* 风险等级 */
.risk-level {
  display: flex;
  align-items: center;
  padding: var(--spacing-lg);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
}

.risk-icon {
  width: 96rpx;
  height: 96rpx;
  background: var(--bg-color-card);
  border-radius: 50%;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.risk-info {
  flex: 1;
}

.risk-name {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.risk-desc {
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
}

/* 指标卡片 */
.metrics-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.metric-item {
  margin-bottom: var(--spacing-sm);
}

.metric-item:last-child {
  margin-bottom: 0;
}

.metric-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.metric-value-row {
  align-items: center;
  gap: var(--spacing-sm);
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: var(--bg-color-card);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-bar-fill.danger {
  background: var(--danger-color);
}

.progress-bar-fill.warning {
  background: linear-gradient(90deg, var(--warning-color), #fbbf24);
}

.progress-bar-fill.success {
  background: var(--success-color);
}

.metric-value {
  color: var(--primary-color);
  min-width: 80rpx;
  text-align: right;
}

/* 概率分布 */
.probability-bar {
  display: flex;
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: var(--spacing-xs);
}

.prob-real {
  background: var(--success-color);
  transition: width 0.3s ease;
}

.prob-fake {
  background: var(--danger-color);
  transition: width 0.3s ease;
}

.probability-labels {
  align-items: center;
}

.prob-label {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
}

.prob-label.real {
  color: var(--success-color);
}

.prob-label.fake {
  color: var(--danger-color);
}

/* 报告卡片 */
.report-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.report-content {
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
  line-height: var(--line-height-normal);
}

/* 🤖 Agent 分析过程卡片 */
.agent-header-left {
  align-items: center;
}

.agent-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--info-color);
  margin-left: var(--spacing-xs);
}

.agent-toggle {
  transition: transform 0.2s;
}

.agent-toggle.expanded {
  transform: rotate(180deg);
}

.agent-body {
  margin-top: var(--spacing-md);
}

.agent-step {
  margin-bottom: var(--spacing-xs);
}

.step-timeline {
  align-items: center;
  width: 32rpx;
  margin-right: var(--spacing-sm);
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d1d5db;
  flex-shrink: 0;
}

.step-dot.done {
  background: var(--success-color);
}

.step-line {
  width: 2rpx;
  flex: 1;
  background: #e5e7eb;
  min-height: 32rpx;
}

.step-content {
  flex: 1;
  padding-bottom: var(--spacing-md);
}

.step-label {
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--text-color-primary);
  display: block;
  margin-bottom: 4rpx;
}

.step-desc {
  color: var(--text-color-tertiary);
  display: block;
}

/* 📚 参考知识源卡片 */
.ref-header-left {
  align-items: center;
}

.ref-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--success-color);
  margin-left: var(--spacing-xs);
}

.ref-count {
  font-size: var(--font-size-xs);
  color: var(--text-color-tertiary);
  background: var(--bg-color-card);
  padding: 4rpx var(--spacing-sm);
  border-radius: var(--radius-full);
}

.ref-body {
  margin-top: var(--spacing-sm);
}

.ref-item {
  padding: var(--spacing-sm) 0;
  border-bottom: 1px solid var(--border-color);
}

.ref-item:last-child {
  border-bottom: none;
}

.ref-item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ref-item-name {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  margin-bottom: 4rpx;
}

.ref-item-cat {
  color: var(--text-color-tertiary);
}

.ref-item-match {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--success-color);
  background: rgba(16, 185, 129, 0.1);
  padding: 6rpx var(--spacing-sm);
  border-radius: var(--radius-xs, 12rpx);
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

/* 建议卡片 */
.advice-card {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.advice-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--success-color);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.advice-list {
  display: flex;
  flex-direction: column;
}

.advice-item {
  align-items: flex-start;
  margin-bottom: var(--spacing-xs);
}

.advice-item:last-child {
  margin-bottom: 0;
}

.advice-text {
  font-size: var(--font-size-md);
  color: var(--text-color-secondary);
  margin-left: var(--spacing-xs);
  flex: 1;
  line-height: var(--line-height-normal);
}

/* 操作按钮 */
.result-actions {
  padding: var(--spacing-md) var(--spacing-lg);
  border-top: 1px solid var(--border-color);
}
