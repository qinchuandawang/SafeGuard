.history-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fcff 0%, var(--bg-color-primary, #eef8ff) 52%, #f8fafc 100%);
  padding-bottom: 80rpx;
}

.history-content {
  padding: 18rpx 32rpx 80rpx;
}

.search-card {
  padding: 14rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid rgba(0,180,216,0.10);
  box-shadow: var(--shadow-sm);
}

.filter-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(0,180,216,0.12);
  color: var(--text-color-secondary, #64748b);
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.filter-chip.active {
  background: linear-gradient(135deg, #0ea5e9, #06b6d4);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(14,165,233,0.22);
}

.filter-chip.level.active {
  background: linear-gradient(135deg, #10b981, #14b8a6);
  box-shadow: 0 10rpx 24rpx rgba(16,185,129,0.20);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 2rpx 14rpx;
  color: var(--text-color-tertiary, #94a3b8);
  font-size: 23rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.history-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.94);
  border: 1rpx solid rgba(255,255,255,0.92);
  box-shadow: var(--shadow-sm);
}

.history-item:active {
  transform: scale(0.99);
  opacity: 0.9;
}

.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-icon.danger { background: #ef4444; }
.item-icon.warning { background: #f59e0b; }
.item-icon.success { background: #10b981; }

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-color-primary, #1e293b);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-level {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.item-level.danger {
  background: rgba(239,68,68,0.10);
  color: #ef4444;
}

.item-level.warning {
  background: rgba(245,158,11,0.12);
  color: #d97706;
}

.item-level.success {
  background: rgba(16,185,129,0.10);
  color: #059669;
}

.item-report {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--text-color-secondary, #64748b);
  font-size: 24rpx;
  line-height: 1.55;
}

.item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.item-meta text {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(15,23,42,0.04);
  color: var(--text-color-tertiary, #94a3b8);
  font-size: 21rpx;
}

.empty-state {
  margin-top: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-title {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-color-primary, #1e293b);
}

.empty-desc {
  margin-top: 10rpx;
  max-width: 480rpx;
  color: var(--text-color-secondary, #64748b);
  font-size: 24rpx;
  line-height: 1.6;
}

@media (prefers-color-scheme: dark) {
  .history-page {
    background: linear-gradient(180deg, #0f172a 0%, #1a1a2e 45%, #16213e 100%);
  }
  .search-card,
  .filter-chip,
  .history-item {
    background: rgba(30,41,59,0.82);
    border-color: rgba(255,255,255,0.06);
  }
}
