/* pages/article/article.wxss - 文章详情样式 */

/* ==================== 页面容器 ==================== */
.article-page {
  min-height: 100vh;
  background-color: var(--bg-color-primary);
}

.page-content {
  padding: 0 var(--spacing-lg) 200rpx;
}

/* ==================== 文章头部 ==================== */
.article-header {
  margin-bottom: var(--spacing-md);
}

.article-title {
  font-size: var(--font-size-xl);
  font-weight: bold;
  color: var(--text-color-primary);
  line-height: 1.4;
  display: block;
  margin-bottom: var(--spacing-md);
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
}

.article-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
}

.article-date {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  flex-shrink: 0;
}

/* ==================== 文章封面 ==================== */
.article-cover {
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--spacing-lg);
}

.cover-image {
  width: 100%;
  height: 100%;
}

/* ==================== 文章内容 ==================== */
.article-body {
  margin-bottom: var(--spacing-lg);
}

.article-content {
  font-size: 30rpx;
  color: var(--text-color-secondary);
  line-height: 1.8;
  display: block;
  white-space: pre-wrap;
}

/* ==================== 相关推荐 ==================== */
.related-section {
  margin-bottom: var(--spacing-lg);
  padding-bottom: 140rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color-primary);
  margin-bottom: var(--spacing-md);
  display: block;
}

.related-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.related-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.related-item:active {
  background: var(--bg-color-card);
}

.related-title {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: var(--spacing-sm);
}

.related-date {
  font-size: var(--font-size-sm);
  color: var(--text-color-tertiary);
  flex-shrink: 0;
}

/* ==================== 底部操作栏 ==================== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-color-card);
  border-top: 1px solid var(--border-color);
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx var(--spacing-lg);
}

.action-item:active {
  opacity: 0.7;
}

.action-text {
  font-size: 22rpx;
  color: var(--text-color-tertiary);
  margin-top: 8rpx;
}
