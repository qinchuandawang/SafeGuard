/* pages/result/result.wxss - 检测结果页样式 */

/* ==================== 页面容器 ==================== */
.result-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 14% 0%, rgba(16,185,129,0.10), transparent 30%),
    radial-gradient(circle at 86% 8%, rgba(239,68,68,0.08), transparent 32%),
    linear-gradient(180deg, #f8fcff 0%, var(--bg-color-primary) 52%, #f8fafc 100%);
  padding-bottom: 180rpx;
}

.page-content {
  padding: 0 var(--spacing-lg);
}

/* ==================== 状态卡片 ==================== */
.status-card {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  position: relative;
  overflow: hidden;
  border-radius: 26rpx;
}

.status-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(110deg, rgba(255,255,255,0.22), transparent 34%);
  pointer-events: none;
}

.status-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
  animation: floatSoft 3.4s ease-in-out infinite;
}

.status-icon-wrapper.danger {
  background: var(--danger-color);
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.3);
}

.status-icon-wrapper.warning {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
}

.status-icon-wrapper.success {
  background: var(--success-color);
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.status-info {
  flex: 1;
}

.status-name {
  font-size: var(--font-size-xl);
  font-weight: bold;
  color: var(--text-color-primary);
  display: block;
  margin-bottom: 12rpx;
}

/* ==================== 卡片通用头部 ==================== */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 1px solid var(--border-color);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color-primary);
  margin-left: 12rpx;
}

/* ==================== 置信度卡片 ==================== */
.confidence-card {
  margin-bottom: var(--spacing-md);
  border-radius: 26rpx;
  overflow: hidden;
}

.confidence-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

/* 主置信度圆环 */
.main-confidence {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.confidence-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  margin-right: var(--spacing-lg);
}

.confidence-hint {
  flex: 1;
  margin-right: var(--spacing-md);
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(245,158,11,0.08);
  color: #b45309;
  font-size: 22rpx;
  line-height: 1.45;
}

.confidence-ring {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  animation: scaleIn 0.45s ease-out both;
}

.ring-bg {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  transition: background 0.5s ease;
}

.ring-bg.danger {
  background: conic-gradient(var(--danger-color) var(--percent), rgba(239,68,68,0.15) var(--percent));
}

.ring-bg.warning {
  background: conic-gradient(var(--warning-color) var(--percent), rgba(245,158,11,0.15) var(--percent));
}

.ring-bg.success {
  background: conic-gradient(var(--success-color) var(--percent), rgba(16,185,129,0.15) var(--percent));
}

.ring-fill {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--bg-color-card);
}

.ring-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.ring-value {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color-primary);
  display: block;
}

.ring-label {
  font-size: 20rpx;
  color: var(--text-color-tertiary);
}

.video-evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: var(--spacing-md);
}

.video-evidence-item {
  min-width: 0;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  background: rgba(15,23,42,0.04);
  text-align: center;
}

.video-evidence-label {
  display: block;
  color: var(--text-color-tertiary);
  font-size: 20rpx;
  line-height: 1.3;
}

.video-evidence-value {
  display: block;
  margin-top: 6rpx;
  color: var(--text-color-primary);
  font-size: 24rpx;
  font-weight: 800;
}

/* 概率分布 */
.probability-section {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.probability-item {
  background: rgba(255,255,255,0.76);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  border: 1rpx solid rgba(255,255,255,0.86);
}

.probability-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.probability-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.probability-label {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  flex: 1;
}

.probability-value {
  font-size: var(--font-size-md);
  font-weight: 600;
}

/* ==================== 报告内容 ==================== */
.report-content {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  line-height: 1.8;
}

.report-content text {
  white-space: pre-wrap;
}

/* ==================== 批量音频明细 ==================== */
.batch-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: var(--spacing-sm);
}

.batch-summary text {
  font-size: 23rpx;
  color: var(--text-color-secondary);
  background: rgba(15,23,42,0.04);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.batch-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.batch-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.76);
  border: 1rpx solid rgba(0,180,216,0.10);
}

.batch-item-main {
  flex: 1;
  min-width: 0;
}

.batch-file-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-color-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-file-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-color-tertiary);
  line-height: 1.4;
}

.batch-level {
  flex-shrink: 0;
  min-width: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}

.batch-level.danger {
  background: var(--danger-color);
}

.batch-level.warning {
  background: var(--warning-color);
}

.batch-level.success {
  background: var(--success-color);
}

.batch-level.failed {
  background: var(--text-color-tertiary);
}

/* ==================== 风险特征 ==================== */
.features-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-color-primary);
  padding: 12rpx var(--spacing-sm);
  background: rgba(255,255,255,0.74);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(239,68,68,0.08);
}

.feature-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--danger-color);
  margin-right: var(--spacing-sm);
}

/* ==================== Agent 调度过程 ==================== */
.agent-step-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.agent-step-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx var(--spacing-sm);
  background: rgba(255,255,255,0.76);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(0,180,216,0.10);
}

.agent-step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin: 8rpx 18rpx 0 4rpx;
  background: #cbd5e1;
  flex-shrink: 0;
}

.agent-step-dot.completed {
  background: var(--success-color);
}

.agent-step-dot.skipped {
  background: var(--text-color-tertiary);
}

.agent-step-main {
  flex: 1;
  min-width: 0;
}

.agent-step-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-color-primary);
  margin-bottom: 6rpx;
}

.agent-step-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-secondary);
  line-height: 1.5;
}

/* ==================== 防范建议 ==================== */
.advice-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.advice-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.advice-number {
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
  min-width: 40rpx;
  text-align: center;
}

.advice-text {
  font-size: 26rpx;
  color: var(--text-color-primary);
  line-height: 1.5;
  flex: 1;
}

/* ==================== 温馨提示 ==================== */
.tips-content {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  line-height: 1.5;
}

/* ==================== 底部操作栏 ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.88);
  border-top: 1px solid rgba(255,255,255,0.86);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-md) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  z-index: 100;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx var(--spacing-lg);
  border-radius: 18rpx;
}

.action-item:active {
  background: rgba(15,23,42,0.04);
  transform: scale(0.96);
}

.action-item text {
  font-size: 22rpx;
  color: var(--text-color-secondary);
  margin-top: 8rpx;
}

/* 隐藏 button 默认样式 */
button.btn {
  border: none;
  padding: 0;
  margin: 0 24rpx;
  flex: 1;
}

button.btn::after {
  border: none;
}

/* ==================== 暗色模式 ==================== */
@media (prefers-color-scheme: dark) {
  .result-page {
    background: #0f172a;
  }

  .card {
    background: #1e293b;
  }

  .ring-fill {
    background: #1e293b;
  }

  .probability-item {
    background: #0f172a;
  }

  .bottom-actions {
    background: #1e293b;
    border-top-color: #334155;
  }

  .feature-item {
    background: #1e293b;
  }

  .batch-summary text,
  .batch-item {
    background: #1e293b;
    border-color: #334155;
  }

  .batch-file-name {
    color: #f1f5f9;
  }

  .batch-file-meta {
    color: #94a3b8;
  }

  .agent-step-row {
    background: #1e293b;
    border-color: #334155;
  }

  .agent-step-title {
    color: #f1f5f9;
  }

  .agent-step-desc {
    color: #94a3b8;
  }

  .status-name {
    color: #f1f5f9;
  }

  .card-title {
    color: #f1f5f9;
  }

  .ring-value {
    color: #f1f5f9;
  }

  .ring-label {
    color: #94a3b8;
  }

  .probability-label {
    color: #94a3b8;
  }

  .report-content {
    color: #94a3b8;
  }

  .report-content text {
    color: #94a3b8;
  }

  .feature-item text {
    color: #e2e8f0;
  }

  .advice-text {
    color: #e2e8f0;
  }

  .tips-content {
    color: #94a3b8;
  }

  .section-header {
    border-bottom-color: #334155;
  }

  .confidence-label {
    color: #94a3b8;
  }
}
