/* pages/knowledge/knowledge.wxss - 防骗知识库样式 */

/* ==================== 页面容器 ==================== */
.knowledge-page {
  min-height: 100vh;
  background-color: var(--bg-color-primary);
}

.page-content { padding-top: var(--spacing-sm);
  padding-bottom: 120rpx;
}

/* ==================== 搜索框 ==================== */
.search-section {
  padding: 0 32rpx 24rpx;
}

/* ==================== 分类导航 ==================== */
.category-nav {
  padding-bottom: 24rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-item {
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  border: 1px solid transparent;
  cursor: pointer;
  flex-shrink: 0;
}

.category-item.active {
  background: var(--bg-color-card);
  border-color: var(--primary-color);
  box-shadow: var(--shadow-sm);
}

.category-text {
  font-size: var(--font-size-sm);
  color: var(--text-color-secondary);
  margin-top: 8rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-item.active .category-text {
  color: var(--primary-color);
}

/* ==================== 热门标签 ==================== */
.tags-section {
  padding: 0 32rpx 24rpx;
}

.tags-list {
  gap: 16rpx;
}

/* ==================== 文章列表 ==================== */
.article-section {
  padding: 0 32rpx;
}

.article-card {
  background: var(--bg-color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.article-card:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.article-cover {
  width: 100%;
  height: 300rpx;
  background: var(--bg-color-card);
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.article-content {
  padding: 24rpx;
}

.article-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color-primary);
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-summary {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-height: 1.5;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.article-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
}

/* 空状态 */
.empty-text {
  margin-top: var(--spacing-md);
}

/* ==================== 热线卡片 ==================== */
.hotline-section {
  padding: 32rpx;
}

.hotline-card {
  padding: 32rpx;
}

.hotline-number {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--danger-color);
}

/* ==================== RAG 智能问答浮动按钮 ==================== */
.qa-float-btn:active {
  transform: scale(0.95);
}

/* ==================== RAG 遮罩 ==================== */
.qa-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.qa-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

/* ==================== RAG 问答面板 ==================== */
.qa-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-color-primary);
  z-index: 300;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.qa-panel.active {
  transform: translateY(0);
}

/* 面板标题 */
.qa-header {
  padding: 24rpx 32rpx;
  padding-top: calc(48rpx + constant(safe-area-inset-top));
  padding-top: calc(48rpx + env(safe-area-inset-top));
  border-bottom: 1px solid var(--border-color);
  flex-shrink: 0;
  background: var(--bg-color-card);
}

.qa-header-close:active {
  background: var(--border-color);
}

/* ==================== 消息列表 ==================== */
.qa-messages {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
  background: var(--bg-color-primary);
}

.qa-msg {
  display: flex;
  margin-bottom: 24rpx;
}

.qa-msg.ai {
  justify-content: flex-start;
}

.qa-msg.user {
  justify-content: flex-end;
}

.qa-msg-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.qa-msg-avatar.ai-avatar {
  background: linear-gradient(135deg, #7c3aed, #00d4ff);
  margin-right: 16rpx;
}

.qa-msg-avatar.user-avatar {
  background: var(--bg-color-card);
  margin-left: 16rpx;
  font-size: var(--font-size-xs);
  color: var(--text-color-secondary);
  border: 1px solid var(--border-color);
}

.qa-msg-content {
  max-width: 75%;
}

.qa-msg-content.user-content {
  display: flex;
  justify-content: flex-end;
}

/* 气泡覆盖 */
.qa-ai-bubble {
  padding: 16rpx 20rpx;
  border-top-left-radius: 8rpx;
}

.qa-user-bubble {
  padding: 16rpx 20rpx;
  border-top-right-radius: 8rpx;
  background: linear-gradient(135deg, #7c3aed, #00d4ff) !important;
}

.qa-bubble-text {
  font-size: var(--font-size-md);
  color: var(--text-color-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

.qa-bubble-text.user-text {
  color: #ffffff;
}

/* ==================== 建议问题 ==================== */
.qa-suggestion {
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.1);
  font-size: var(--font-size-sm);
  padding: 8rpx 20rpx;
  font-weight: 400;
}

.qa-suggestion:active {
  background: rgba(124, 58, 237, 0.2);
}

/* ==================== 参考来源 ==================== */
.qa-refs {
  margin-top: 16rpx;
  padding-top: 16rpx;
}

.qa-ref-title {
  margin-bottom: 8rpx;
}

.qa-ref-item:active {
  opacity: 0.8;
}

/* ==================== 打字动画 ==================== */
.typing-dots {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
}

.typing-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--text-color-tertiary);
  border-radius: 50%;
  animation: typingBounce 1.4s infinite ease-in-out;
}

.typing-dots .dot:nth-child(1) { animation-delay: 0s; }
.typing-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* ==================== 输入区域 ==================== */
.qa-input-area {
  flex-shrink: 0;
}

.qa-send-btn.active {
  background: linear-gradient(135deg, #7c3aed, #00d4ff) !important;
}
