<!-- pages/knowledge/knowledge.wxml - 防骗知识库 -->
<view class="knowledge-page">

  <!-- 自定义导航栏 -->
  <view class="page-navbar px-lg">
    <view class="page-nav-left" bindtap="onBack">
      <t-icon name="chevron-left" size="48rpx" color="var(--text-color-primary)" />
    </view>
    <text class="page-nav-title">防骗知识库</text>
    <view class="page-nav-right"></view>
  </view>

  <view class="page-content anim-fadeIn">
    <!-- 搜索框 -->
    <view class="search-section px-lg pb-md">
      <t-search
        placeholder="搜索防骗知识..."
        value="{{searchKey}}"
        bind:change="onSearchChange"
        bind:clear="onClearSearch"
        bind:submit="onSearchSubmit"
      />
    </view>

    <!-- 分类导航 -->
    <view class="category-nav pb-md">
      <scroll-view scroll-x class="category-scroll">
        <view class="category-list flex" style="padding:0 24rpx;gap:0">
          <view
            class="card category-item {{currentCategory === item.id ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="id"
            bindtap="selectCategory"
            data-id="{{item.id}}"
          >
            <t-icon name="{{item.icon}}" size="36rpx" color="{{currentCategory === item.id ? item.color : 'var(--text-color-tertiary)'}}" />
            <text class="category-text">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 热门标签 -->
    <view class="tags-section px-lg pb-md" wx:if="{{!searchKey}}">
      <text class="text-sm text-secondary block mb-sm">热门标签</text>
      <view class="tags-list flex flex-wrap" style="gap:16rpx">
        <view
          class="tag tag-primary"
          wx:for="{{hotTags}}"
          wx:key="index"
          bindtap="searchByTag"
          data-tag="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <!-- 文章列表 -->
    <view class="article-section px-lg" style="flex:1;overflow:hidden;display:flex;flex-direction:column;min-height:0">
      <text class="text-lg font-bold mb-md block">{{currentCategoryName}}</text>

      <scroll-view scroll-y class="article-list-scroll" enhanced show-scrollbar="{{false}}" style="flex:1;overflow-y:auto">
      <view class="article-list flex flex-col" style="padding-bottom:32rpx">
        <view
          class="article-card stagger-1"
          wx:for="{{filteredArticles}}"
          wx:key="id"
          bindtap="viewArticle"
          data-id="{{item.id}}"
        >
          <view class="article-cover" wx:if="{{item.cover}}">
            <image src="{{item.cover}}" mode="aspectFill" class="cover-image" lazy-load />
          </view>
          <view class="article-content">
            <text class="article-title">{{item.title}}</text>
            <text class="article-summary">{{item.summary}}</text>
            <view class="article-meta flex flex-between">
              <view class="article-tags flex" style="gap:12rpx;flex-wrap:wrap;flex:1">
                <text class="tag tag-primary" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
              </view>
              <text class="article-date text-xs text-tertiary" style="flex-shrink:0">{{item.date}}</text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-state flex flex-col flex-center py-xl" wx:if="{{filteredArticles.length === 0}}">
          <t-icon name="search" size="80rpx" color="var(--text-color-tertiary)" />
          <text class="empty-text mt-md text-sm text-tertiary">未找到相关文章</text>
        </view>
      </view>
      </scroll-view>
    </view>

    <!-- 防骗热线 -->
    <view class="hotline-section px-lg" style="padding-top:32rpx;padding-bottom:32rpx">
      <view class="card-glow hotline-card" style="display:flex;align-items:center;gap:24rpx">
        <view class="hotline-icon flex-center" style="width:96rpx;height:96rpx;border-radius:50%;background:rgba(239,68,68,0.2);flex-shrink:0">
          <t-icon name="service" size="48rpx" color="var(--danger-color)" />
        </view>
        <view class="flex-1">
          <text class="text-sm text-secondary block mb-xs">全国反诈热线</text>
          <text class="hotline-number">96110</text>
        </view>
        <view class="hotline-call flex-center" style="background:var(--danger-color);padding:16rpx 32rpx;border-radius:var(--radius-full);gap:8rpx;flex-shrink:0" bindtap="callHotline">
          <t-icon name="call" size="32rpx" color="#ffffff" />
          <text class="text-sm" style="color:#ffffff;font-weight:500">立即拨打</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== RAG 智能问答浮动按钮 ===== -->
  <view class="qa-float-btn flex flex-col flex-center" style="position:fixed;right:32rpx;bottom:120rpx;width:112rpx;height:112rpx;background:linear-gradient(135deg,#7c3aed,#00d4ff);border-radius:50%;box-shadow:var(--shadow-glow);z-index:100" bindtap="toggleQA">
    <t-icon name="chat" size="36rpx" color="#ffffff" />
    <text class="text-xs" style="color:#ffffff;margin-top:4rpx">问 AI</text>
  </view>

  <!-- ===== RAG 智能问答面板 ===== -->
  <view class="qa-panel {{showQA ? 'active' : ''}}">
    <!-- 面板标题 -->
    <view class="qa-header flex flex-between">
      <view class="flex flex-center" style="gap:12rpx">
        <t-icon name="chat" size="32rpx" color="#7c3aed" />
        <text class="text-lg font-bold">AI 智能问答</text>
        <text class="tag tag-primary" style="font-weight:500">RAG</text>
      </view>
      <view class="qa-header-close flex-center" style="gap:6rpx;padding:12rpx 24rpx;background:var(--bg-color-card);border-radius:var(--radius-full);min-width:100rpx" bindtap="toggleQA">
        <t-icon name="close" size="36rpx" color="var(--text-color-tertiary)" />
        <text class="text-sm text-secondary">退出</text>
      </view>
    </view>

    <!-- 消息列表 -->
    <scroll-view class="qa-messages" scroll-into-view="{{lastMsgId}}" scroll-y>
      <!-- 欢迎消息 -->
      <view class="qa-msg ai" wx:if="{{qaMessages.length === 0}}">
        <view class="qa-msg-avatar ai-avatar">
          <t-icon name="chat" size="24rpx" color="#ffffff" />
        </view>
        <view class="qa-msg-content">
          <view class="card qa-ai-bubble">
            <text class="qa-bubble-text">你好！我是反诈AI助手，你可以问我任何关于诈骗防范的问题。例如：</text>
            <view class="qa-suggestions flex flex-wrap" style="gap:12rpx;margin-top:16rpx">
              <text class="qa-suggestion tag" bindtap="askQuestion" data-q="{{item}}" wx:for="{{suggestions}}" wx:key="index">{{item}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:for="{{qaMessages}}" wx:key="id" id="msg-{{item.id}}">
        <!-- 用户消息 -->
        <view class="qa-msg user animate-scaleIn" wx:if="{{item.role === 'user'}}">
          <view class="qa-msg-content user-content">
            <view class="bg-primary-light qa-user-bubble">
              <text class="qa-bubble-text user-text">{{item.content}}</text>
            </view>
          </view>
          <view class="qa-msg-avatar user-avatar">我</view>
        </view>

        <!-- AI 消息 -->
        <view class="qa-msg ai animate-scaleIn" wx:if="{{item.role === 'ai'}}">
          <view class="qa-msg-avatar ai-avatar">
            <t-icon name="chat" size="24rpx" color="#ffffff" />
          </view>
          <view class="qa-msg-content">
            <view class="card qa-ai-bubble">
              <text class="qa-bubble-text">{{item.content}}</text>
              <!-- 引用来源 -->
              <view class="qa-refs" wx:if="{{item.references && item.references.length > 0}}">
                <view class="divider"></view>
                <text class="qa-ref-title text-xs text-tertiary block mb-xs">参考来源</text>
                <view class="qa-ref-item flex flex-center" wx:for="{{item.references}}" wx:key="index" bindtap="viewArticleByRef" data-id="{{item.articleId}}" style="gap:8rpx;margin-bottom:8rpx;padding:8rpx 12rpx;background:var(--bg-color-card);border-radius:var(--radius-md)">
                  <t-icon name="book-open" size="24rpx" color="var(--success-color)" />
                  <text class="text-sm" style="color:var(--success-color)">{{item.title}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 打字中 -->
      <view class="qa-msg ai" wx:if="{{qaLoading}}">
        <view class="qa-msg-avatar ai-avatar">
          <t-icon name="chat" size="24rpx" color="#ffffff" />
        </view>
        <view class="qa-msg-content">
          <view class="card qa-ai-bubble">
            <view class="typing-dots">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 输入区域 -->
    <view class="qa-input-area flex flex-center" style="padding:16rpx 32rpx;padding-bottom:calc(16rpx + constant(safe-area-inset-bottom));padding-bottom:calc(16rpx + env(safe-area-inset-bottom));border-top:1px solid var(--border-color);background:var(--bg-color-card)">
      <view class="qa-input-wrapper flex-1 flex-center" style="background:var(--bg-color-card);border-radius:var(--radius-full);padding:0 24rpx;margin-right:16rpx">
        <input class="qa-input" type="text" placeholder="输入防骗问题..." value="{{qaInput}}" bindinput="onQAInput" bindconfirm="sendQuestion" confirm-type="send" style="height:72rpx;font-size:var(--font-size-md);color:var(--text-color-primary);flex:1" />
      </view>
      <view class="qa-send-btn flex-center {{qaInput.trim() ? 'active' : ''}}" style="width:72rpx;height:72rpx;background:var(--bg-color-card);border-radius:50%" bindtap="sendQuestion">
        <t-icon name="chat" size="28rpx" color="{{qaInput.trim() ? '#ffffff' : 'var(--text-color-tertiary)'}}" />
      </view>
    </view>
  </view>

  <!-- 遮罩 -->
  <view class="qa-overlay {{showQA ? 'active' : ''}}" bindtap="toggleQA"></view>
</view>
